# 下記の内容で各自.env.localを作成してください
VITE_APP_REGION=ap-northeast-1
VITE_APP_USER_POOL_ID=ap-northeast-1_XXX
VITE_APP_USER_POOL_CLIENT_ID=xxxx
# VITE_APP_API_ENDPOINT について:
# 標準のローカル開発はローカル backend を使う。VITE_APP_API_ENDPOINT を
# http://localhost:3000 に設定する（または未設定にする。未設定なら
# frontend/src/hooks/useHttp.ts のフォールバックで http://localhost:3000 が使われる）。
VITE_APP_API_ENDPOINT=http://localhost:3000
# デプロイ済みの「本番リソース」に直接つなぐ場合のみ、下記のように API Gateway の URL を指定する。
#   VITE_APP_API_ENDPOINT=https://xxxx.execute-api.ap-northeast-1.amazonaws.com/api/
